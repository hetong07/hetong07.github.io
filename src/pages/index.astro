---
import { getCollection } from "astro:content";
import Container from "@components/Container.astro";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { SITE, HOME, SOCIALS } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0,SITE.NUM_POSTS_ON_HOMEPAGE);

// TODO: when you add projects/work content, re-enable these queries and the
// matching sections below (and the nav links in Header.astro).
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h1 class="animate font-semibold text-black dark:text-white">
      Hi, I'm Tong <span class="text-xl">👋🏻</span>
    </h1>
    <div class="space-y-16">
      <section>
        <article class="space-y-4">
          <p class="animate">
            I'm a software engineer and individual systems researcher. My work
            spans two ends of the systems spectrum: pure distributed software,
            and the boundary where software meets hardware.
          </p>
          <p class="animate">
            On the software side, I work on Pathways and Plaque &mdash;
            Google's distributed dataflow system for ML and the sharded runtime
            it's built on. Before that, I was the owner of a custom streaming
            data-processing system that operated at Google cloud scale while
            guaranteeing strong consistency at low latency.
          </p>
          <p class="animate">
            At the hardware boundary, I worked on
            <Link href="https://www.usenix.org/conference/atc19/presentation/ruan" aria-label="INSIDER paper at USENIX ATC 2019" external>
              INSIDER
            </Link>,
            an in-storage computing platform, and
            <Link href="https://ieeexplore.ieee.org/document/8457626" aria-label="ST-Accel paper on IEEE Xplore" external>
              ST-Accel
            </Link>
            for FPGA streaming, and earlier worked on ClickNP at Microsoft
            Research &mdash; part of the Catapult effort to bring FPGAs into the
            datacenter.
          </p>
          <p class="animate">
            These days, I'm focused on
            <span class="text-black dark:text-white">scaling LLM pre-training systems</span>
            &mdash; and just as curious about the payoff: turning raw capability
            into applications that matter. This is where I write about what I'm
            building and thinking about.
          </p>
        </article>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-black dark:text-white">
            Latest posts
          </h2>
          <Link href="/blog">
            See all posts
          </Link>
        </div>
        <ul class="flex flex-col gap-4">
          {blog.map(post => (
            <li>
              <ArrowCard entry={post} />
            </li>
          ))}
        </ul>
      </section>

      {/* TODO: Work Experience and Recent projects sections were removed for the
          blog-first launch. Restore them (and their queries above) when you add
          content to the work/ and projects/ collections. */}

      <section class="animate space-y-4">
        <h2 class="font-semibold text-black dark:text-white">
          Let's Connect
        </h2>
        <article>
          <p>
            If you want to get in touch with me about something or just to say hi,
            reach out on social media or send me an email.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2">
          {SOCIALS.map(SOCIAL => (
            <li class="flex gap-x-2 text-nowrap">
              <Link href={SOCIAL.HREF} external aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}>
                {SOCIAL.NAME}
              </Link>
              {"/"}
            </li>
          ))}
          <li class="line-clamp-1">
            <Link href={`mailto:${SITE.EMAIL}`} aria-label={`Email ${SITE.NAME}`}>
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
